@model SystemForManagingFitnessTrainings.Entities.TrainingPlan

<h2>Your Training Plan</h2>

@if (Model == null)
{
    <p>You don't have a training plan yet. <a asp-controller="TrainingPlan" asp-action="Create">Create one now</a>.</p>
}
else
{
    <div>
        <h3>@Model.Name</h3>
        <p>Frequency: @Model.Frequency times per week</p>

        <h4>Exercises:</h4>
        <ul>
            @foreach (var exercise in Model.User.Exercises)
            {
                <li>@exercise.Name</li>
            }
        </ul>

        <a asp-controller="TrainingPlan" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
    </div>
}
