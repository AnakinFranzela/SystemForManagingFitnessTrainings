@using SystemForManagingFitnessTrainings.Entities
@{
	ViewData["Title"] = "Създаване на тренировка";
}
@model SystemForManagingFitnessTrainings.ViewModels.TrainingPlanViewModel

@section Styles{
<link rel="stylesheet" href="/css/training_plan/create-edit_training.css" />
}

@if (!ViewData.ModelState.IsValid)
{
	<div class="alert alert-danger">
		@Html.ValidationSummary(false, "", new { @class = "text-danger" })
	</div>
}
<div class="container my-4">
	<div class="card shadow">
		<div class="card-body">
			<h3 class="card-title mb-4">Създаване на тренировъчен план</h3>
			<form asp-controller="TrainingPlan" asp-action="Create" method="post">
				<input type="hidden" asp-for="Id" />

				<div asp-validation-summary="All"></div>

				<div class="mb-3">
					<label asp-for="Name">Име на плана</label>
					<input asp-for="Name" class="form-control" required />
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>
				<div class="mb-3">
					<label asp-for="Frequency">Честота на тренировка (дни в седмицата)</label>
					<input asp-for="Frequency" class="form-control" required />
					<span asp-validation-for="Frequency" class="text-danger"></span>
				</div>
				<!-- Dropdown for selecting exercises -->
				<div class="mb-3">
					<label><strong>Избери упражнения:</strong></label>
					<span id="error-msg" style="color:red; display:none;">
						Трябва да изберете поне едно упражнение.
					</span>
					<div class="row" id="checkboxes-group">
						@foreach (var exercise in Model.Exercises.OrderBy(t => t.Category))
						{
							<div class="col-md-6 col-lg-4">
								<div class="form-check">
									<input class="form-check-input"
										   type="checkbox"
										   name="SelectedExercisesIds"
										   id="exercise-@exercise.Id"
										   value="@exercise.Id"
									@(Model.SelectedExercisesIds.Contains(exercise.Id) ? "checked" : "") />
									<label class="form-check-label" for="exercise-@exercise.Id">
										@exercise.Name (@exercise.Category)
									</label>
								</div>
							</div>
						}
					</div>
				</div>
				<div class="d-flex justify-content-center" style="">
					<button type="submit" class="btn btn-success w-100" id="submit-btn">Създай</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/exercise-validation.js"></script>
}
