@using SystemForManagingFitnessTrainings.Entities
@{
    ViewData["Title"] = "Training Scheduler";
}
@model SystemForManagingFitnessTrainings.ViewModels.TrainingPlanViewModel

@section Styles {
    <!-- FullCalendar CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.2.0/fullcalendar.min.css" rel="stylesheet" />

    <!-- jQuery (required for FullCalendar) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- FullCalendar JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.2.0/fullcalendar.min.js"></script>
}


<h2>Training Scheduler</h2>

@if (!ViewData.ModelState.IsValid@*  && ViewData.ModelState[""].Errors.Any() *@)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
}

<form asp-controller="TrainingPlan" asp-action="Create" method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Frequency"></label>
        <input asp-for="Frequency" class="form-control" required />
        <span asp-validation-for="Frequency" class="text-danger"></span>
    </div>
    <!-- Dropdown for selecting exercises -->
    <div class="form-group" id="checkboxes-group">
        <label>Select Exercises:</label>
        @foreach (var exercise in Model.Exercises)
        {
            <div>
                <input type="checkbox"
                       name="SelectedExercisesIds"
                       value="@exercise.Id"
                @(Model.SelectedExercisesIds.Contains(exercise.Id) ? "checked" : "")/>
                @exercise.Name (@exercise.Category)
            </div>
        }
    </div>
    <span id="error-msg" style="color:red; display:none;">
        Please select at least one exercise.
    </span>
    <button type="submit" class="btn btn-primary" id="submit-btn">Create</button>
</form>

@section Scripts {
    <script src="~/js/exercise-validation.js"></script>
}
