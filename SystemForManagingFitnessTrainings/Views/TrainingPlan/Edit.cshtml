@model SystemForManagingFitnessTrainings.ViewModels.TrainingPlanViewModel

@if (Model != null)
{
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Frequency"></label>
            <input asp-for="Frequency" class="form-control" required />
            <span asp-validation-for="Frequency" class="text-danger"></span>
        </div>


        <div class="form-group" id="checkboxes-group">
            <label>Select Exercises:</label>
            @foreach (var exercise in Model.Exercises)
            {
                <div>
                    <input type="checkbox"
                           name="SelectedExercisesIds"
                           value="@exercise.Id"
                    @(Model.SelectedExercisesIds.Contains(exercise.Id) ? "checked" : "") />
                    @exercise.Name (@exercise.Category)
                </div>
            }
        </div>

        <span id="error-msg" style="color:red; display:none;">
            Please select at least one exercise.
        </span>

        <button type="submit" class="btn btn-primary" id="submit-btn">Save</button>
    </form>
}
else
{
    <a asp-action="Create">Create Plan</a>
}

@section Scripts{
    <script src="~/js/exercise-validation.js"></script>
}