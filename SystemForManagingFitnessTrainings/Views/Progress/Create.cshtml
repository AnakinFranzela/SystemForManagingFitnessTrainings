@model SystemForManagingFitnessTrainings.ViewModels.ProgressViewModel
@{
    ViewData["Title"] = "Добаване на прогрес";
}

@section Styles{
    <link rel="stylesheet" href="/css/progress/create_progress.css" />
}

<form class="form-fixing" asp-controller="Progress" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <h2 class="d-flex justify-content-center">Въведи прогрес</h2>

    <div class="form-group">
        <label>Упражнение</label>
        <select asp-for="ExerciseId" asp-items="@(new SelectList(ViewBag.TrainingPlan.User.Exercises, "Id", "Name"))" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Дата</label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Тежести (в килограми):</label>
        <input asp-for="Weight" type="number" class="form-control" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Повторения:</label>
        <input asp-for="Repetition" type="number" class="form-control" />
        <span asp-validation-for="Repetition" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Време (в секунди):</label>
        <input asp-for="TimeInSeconds" type="number" class="form-control" />
        <span asp-validation-for="TimeInSeconds" class="text-danger"></span>
    </div>

    <button class="btn btn-primary w-100" style="margin-top: 30px;" type="submit">Save</button>
</form>
