@model SystemForManagingFitnessTrainings.ViewModels.ProgressViewModel
@{
    ViewData["Title"] = "Log Progress";
}

<h2>Въведи прогрес</h2>

<form asp-controller="Progress" asp-action="Create" method="post">
    <div class="form-group">
        <label>Упражнение:</label>
        <select asp-for="ExerciseId" class="form-control" asp-items="@(new SelectList(ViewBag.TrainingPlan.User.Exercises, "Id", "Name"))"></select>
    </div>
    <div class="form-group">
        <label>Дата:</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Резултати:</label>
        <textarea asp-for="Results" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Save</button>
</form>
