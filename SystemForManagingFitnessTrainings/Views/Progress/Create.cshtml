@model SystemForManagingFitnessTrainings.ViewModels.ProgressViewModel
@{
    ViewData["Title"] = "Log Progress";
}

<h2>Въведи прогрес</h2>

<form asp-controller="Progress" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Exercise</label>
        <select asp-for="ExerciseId" asp-items="@(new SelectList(ViewBag.TrainingPlan.User.Exercises, "Id", "Name"))" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Weight:</label>
        <input asp-for="Weight" type="number" step="0.1" class="form-control" />
    </div>

    <div class="form-group">
        <label>Reps:</label>
        <input asp-for="Repetition" type="number" class="form-control" />
    </div>

    <div class="form-group">
        <label>Time (seconds):</label>
        <input asp-for="TimeInSeconds" type="number" class="form-control" />
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
</form>
