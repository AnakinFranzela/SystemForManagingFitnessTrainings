@model List<SystemForManagingFitnessTrainings.Entities.Progress>

<h2>Моят прогрес</h2>
<table class="table">
	<thead>
		<tr>
			<th>Exercise</th>
			<th>Date</th>
			<th>Results</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var progress in Model)
		{
			<tr>
				<td>@progress.Exercise.Name</td>
				<td>@progress.Date.ToShortDateString()</td>
				<td>@progress.Results</td>
			</tr>
		}
	</tbody>
</table>

<canvas id="progressChart" width="1000" height="200"></canvas>

@section Scripts{
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script>
		var ctx = document.getElementById('progressChart').getContext('2d');
		var chart = new Chart(ctx, {
			type: 'line',
			data: {
				labels: @Html.Raw(Json.Serialize(Model.Select(m => m.Date.ToShortDateString()))),
				datasets: [{
					label: 'Progress',
					data: @Html.Raw(Json.Serialize(Model.Select(m => m.Results).ToArray())) // Adjust for numeric data
				}]
			}
		});
	</script>
}