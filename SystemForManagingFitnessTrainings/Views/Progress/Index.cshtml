@model List<SystemForManagingFitnessTrainings.Entities.Progress>

<div class="container my-4">
    <div class="card shadow">
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Моят прогрес</h2>

            <!-- Progress Table -->
            <div class="table-responsive mb-4">
                <table class="table table-striped table-bordered table-hover align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Exercise</th>
                            <th scope="col">Date</th>
                            <th scope="col">Results</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var progress in Model)
                        {
                            <tr>
                                <td>@progress.Exercise.Name</td>
                                <td>@progress.Date.ToShortDateString()</td>
                                <td>@progress.Results</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mb-3 d-flex justify-content-center">
                <a asp-controller="Progress" asp-action="Create" class="btn btn-success me-3">Добави прогрес</a>

                <!-- Drop-down for selecting which exercise to chart -->
                <div>
                    <label for="exerciseFilter" class="form-label me-2">Избери упражнение:</label>
                    <select id="exerciseFilter" class="form-select d-inline-block w-auto">
                        <option value="">-- Избери упражнение --</option>
                        @foreach (var ex in ViewBag.ExerciseRecords)
                        {
                            <option value="@ex.Exercise.Id">@ex.Exercise.Name</option>
                        }
                    </select>
                    <button id="filterBtn" class="btn btn-primary ms-2">Покажи графика</button>
                </div>
            </div>

            <hr />

            <!-- Chart Container -->
            <div class="chart-container" style="justify-content: center;">
                <canvas id="progressChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let progressChart; // We'll store the Chart instance to update it

        // On "Show Chart" button click, load data from server for selected exercise
        document.getElementById('filterBtn').addEventListener('click', function () {
            var exerciseId = document.getElementById('exerciseFilter').value;
            if (!exerciseId) {
                alert('Моля избери упражнение!');
                return;
            }
            loadChartData(exerciseId);
        });

        function loadChartData(exerciseId) {
            fetch('/Progress/GetExerciseProgressData?exerciseId=' + exerciseId)
                .then(response => response.json())
                .then(data => {
                    // data is an array of objects: { date, weight, reps, timeSec }

                    // Extract arrays for Chart labels and each metric
                    const labels = data.map(d => d.date);
                    const weights = data.map(d => d.weight);
                    const reps = data.map(d => d.reps);
                    const times = data.map(d => d.timeSec);

                    // If the chart already exists, destroy it before creating new
                    if (progressChart) {
                        progressChart.destroy();
                    }

                    // Create or re-create a line chart with multiple datasets
                    const ctx = document.getElementById('progressChart').getContext('2d');
                    progressChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    label: 'Тежести (kg)',
                                    data: weights,
                                    yAxisID: 'yAxisWeight',
                                    borderColor: 'blue',
                                    backgroundColor: 'rgba(0, 0, 255, 0.1)'
                                },
                                {
                                    label: 'Повторения',
                                    data: reps,
                                    yAxisID: 'yAxisReps',
                                    borderColor: 'red',
                                    backgroundColor: 'rgba(255, 0, 0, 0.1)'
                                },
                                {
                                    label: 'Време (секунди)',
                                    data: times,
                                    yAxisID: 'yAxisTime',
                                    borderColor: 'orange',
                                    backgroundColor: 'rgba(255, 165, 0, 0.1)'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                yAxisWeight: {
                                    type: 'linear',
                                    position: 'left',
                                    title: {
                                        display: true,
                                        text: 'Тежести (kg)'
                                    }
                                },
                                yAxisReps: {
                                    type: 'linear',
                                    position: 'right',
                                    title: {
                                        display: true,
                                        text: 'Повторения'
                                    },
                                    grid: {
                                        drawOnChartArea: false // separate left & right
                                    }
                                },
                                yAxisTime: {
                                    type: 'linear',
                                    position: 'right',
                                    title: {
                                        display: true,
                                        text: 'Време (секунди)'
                                    },
                                    grid: {
                                        drawOnChartArea: false
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(err => console.error(err));
        }
    </script>
}