@{
    ViewData["Title"] = "Workout Calendar";
}

<div id="calendar"></div>

<!-- Modal for adding sessions -->
<div class="modal fade" id="addSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Session - <span id="selectedDate"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="sessionDate" />
                <div id="exerciseList"></div>
            </div>
            <div class="modal-footer">
                <button id="saveSessionBtn" class="btn btn-primary">Save Session</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

    <script>
        $(document).ready(function () {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                events: '/Calendar/GetSessions',
                dateClick: function (info) {
                    $('#selectedDate').text(info.dateStr);
                    $('#sessionDate').val(info.dateStr);

                    // Load user-specific exercises clearly
                    $.getJSON('/Calendar/GetUserExercises', function (exercises) {
                        var htmlContent = '';
                        exercises.forEach(e => {
                            html += `
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="${e.id}" id="exercise-${e.id}">
                                <label class="form-check-label" for="exercise-${e.id}">${e.name}</label>
                            </div>`;
                        });
                        $('#exerciseList').html(html);
                    });

                    $('#addSessionModal').modal('show');
                }
            });

            calendar.render();

            $('#saveSessionBtn').click(function () {
                let selectedExerciseIds = $('#exerciseList input:checked')
                    .map((_, e) => parseInt(e.value)).get();

                if (selectedExerciseIds.length === 0) {
                    alert('Select at least one exercise.');
                    return;
                }

                $.ajax({
                    url: '/Calendar/CreateSession',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Date: $('#sessionDate').val(),
                        SelectedExerciseIds: selectedExerciseIds
                    }),
                    success: function (response) {
                        if (response.success) {
                            $('#addSessionModal').modal('hide');
                            calendar.refetchEvents();
                        } else {
                            alert('Could not save session.');
                        }
                    },
                    error: function () {
                        alert('An error occurred.');
                    }
                });
            });

            calendar.render();
        });
    </script>
}
