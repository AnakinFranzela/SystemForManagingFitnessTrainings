@model SystemForManagingFitnessTrainings.ViewModels.ExerciseViewModel

@{
	ViewData["Title"] = "Редактиране на упражнение";
}

@section Styles {
	<link rel="stylesheet" href="/css/exercise/create-edit_exercise.css" />
}

@if (Model != null)
{
	<form class="fixing" asp-controller="Exercise" asp-action="Edit">
		<h2 class="d-flex justify-content-center" style="margin-bottom: 30px;">Редактиране на упражнение</h2>
		<div class="form-group">
			<label asp-for="Name">Име</label>
			<input asp-for="Name" class="form-control" />
			<span asp-validation-for="Name" class="text-danger"></span>
		</div>

		<div class="form-group">
			<label asp-for="Category">Категория</label>
			<select asp-for="Category" class="form-control" asp-items="ViewBag.Categories">
				<option value="">-- Избери категория --</option>
			</select>
			<span asp-validation-for="Category" class="text-danger"></span>
		</div>

		<div class="form-group">
			<label asp-for="Description">Описание</label>
			<input asp-for="Description" class="form-control" />
			<span asp-validation-for="Description" class="text-danger"></span>
		</div>

		<div class="d-flex justify-content-center">
			<button type="submit" class="btn btn-primary w-100" style="margin-top: 20px;" id="submit-btn">Запази</button>
		</div>
	</form>
}